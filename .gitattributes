# docs/index.html is generated by `brownlow report`, not written by hand. Its
# data sits on a few very long lines, so a diff of it is unreadable noise in a
# pull request. Mark it generated: GitHub collapses it by default (you can still
# expand it), and it stops the file dominating the repository's language stats.
docs/index.html linguist-generated=true

# Keep line endings consistent so a Windows checkout does not rewrite the world.
* text=auto eol=lf
